{
  "name": "easyrent",
  "version": "1.0.0",
  "description": "Sistema de Gestión Inmobiliaria EasyRent",
  "main": "electron/main.js",
  "author": "HRA Estadistica",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "build:renderer": "vite build",
    "build:web": "vite build --outDir dist-web",
    "build:win": "taskkill /F /IM EasyRent.exe /T /FI \"STATUS eq RUNNING\" & npm run build:renderer && electron-builder --win --x64",
    "build:clean": "rimraf dist dist-renderer dist-web && npm run build:win",
    "cache:clean": "rimraf %LOCALAPPDATA%\\electron-builder\\Cache\\winCodeSign",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.hraestadistica.easyrent",
    "productName": "EasyRent",
    "copyright": "Copyright 2025 HRA Estadistica",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "dist-renderer/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "public/icon.ico"
    },
    "extraResources": [
      {
        "from": "electron/",
        "to": "electron",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.97.0",
    "better-sqlite3": "^9.4.3",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron-updater": "^6.1.8",
    "exceljs": "^4.4.0",
    "framer-motion": "^11.0.8",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "lucide-react": "^0.344.0",
    "node-machine-id": "^1.1.12",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-router-dom": "^6.22.3",
    "recharts": "^2.12.2",
    "wait-on": "^7.2.0"
  },
  "devDependencies": {
    "@tanstack/react-table": "^8.13.2",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "electron": "^29.1.4",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.5"
  }
}